# Website: HTTPS/WSS addresses for the separate persistent game service.
# In production, set these before building the website on Vercel.
NEXT_PUBLIC_GAME_SERVER_URL=ws://127.0.0.1:3030
GAME_SERVER_HTTP_URL=http://127.0.0.1:3030

# Game server: the exact website origin(s), separated by commas, with no trailing slash.
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
ROOM_DATABASE_PATH=.data/rooms.sqlite
# Production example: ROOM_DATABASE_PATH=/var/data/uno/rooms.sqlite
# PORT=3030
# BACKUP_DIRECTORY=/var/data/uno/backups
