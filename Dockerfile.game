FROM node:24-bookworm-slim AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY src/types ./src/types
COPY src/utils ./src/utils
COPY src/online/protocol.ts ./src/online/protocol.ts
COPY server ./server
RUN npm run server:build
FROM node:24-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production PORT=3030 ROOM_DATABASE_PATH=/var/data/uno/rooms.sqlite
COPY package*.json ./
RUN npm ci --omit=dev
COPY --from=build /app/dist-game ./dist-game
RUN mkdir -p /var/data/uno && chown -R node:node /var/data/uno
USER node
EXPOSE 3030
CMD ["node","dist-game/index.mjs"]
